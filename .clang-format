# ============================================================================
# .clang-format — Broadcast Appliance Portable v2
#
# Replica del estilo de facto que YA usa el codigo en src/ (no impone un
# estilo nuevo). El target `make lint` corre `clang-format --dry-run -Werror`
# sobre src/; con este archivo el codigo queda "ya formateado" y el lint
# queda verde sin reformatear nada.
#
# Convenciones (verificadas en src/core/*):
#   - 4 espacios, sin tabs.
#   - Modificadores de acceso (`public:`/`private:`) en columna 0.
#   - Punteros/referencias alineados a la IZQUIERDA (`const std::string& x`).
#   - Llaves pegadas a la declaracion (`struct Foo {`).
#   - Funciones, if, lambdas y case-labels cortos en una sola linea cuando caben.
#   - Naming: clases/structs PascalCase; metodos/funciones/vars/params
#     camelCase; miembros camelCase + sufijo `_`; constantes `k`+PascalCase.
#
# ⚠️  Compatibilidad: este archivo se valida contra el clang-format de la
# distribucion (Ubuntu 24.04 / noble -> 18.1.3, el que instala el job `lint`
# de CI por apt). Solo usa claves que ESA version acepta. En particular, las
# claves `AllowShortBlocks*` y `NamingConventions` NO existen en 18.1.3
# (`NamingConventions` es un check de clang-tidy, `readability-identifier-naming`,
# no una opcion de clang-format), así que se documentan aqui como comentario.
# ============================================================================

BasedOnStyle: LLVM
IndentWidth: 4
UseTab: Never
TabWidth: 4
ColumnLimit: 110
AccessModifierOffset: -1
PointerAlignment: Left
DerivePointerAlignment: false
# Claves cortas en una linea (nombres validos en 18.1.3; la familia es
# `...OnASingleLine`, no `...OnOneLine`/`AllowShortBlocks*` que no existen):
# replica el estilo de facto de src/ (funciones/if/lambdas/case cortos en una
# linea cuando caben).
AllowShortFunctionsOnASingleLine: All
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLambdasOnASingleLine: All
AllowShortCaseLabelsOnASingleLine: true
NamespaceIndentation: None
FixNamespaceComments: true
SortIncludes: CaseInsensitive
IncludeBlocks: Preserve
IndentCaseLabels: true
SpaceBeforeParens: ControlStatements
ConstructorInitializerIndentWidth: 4
Standard: c++20
Language: Cpp

# --- Convenciones de naming (DOMINIO DE clang-tidy, no de clang-format) -----
# clang-format NO renombra identificadores: esta es la responsabilidad del
# check `readability-identifier-naming` de clang-tidy. Se documentan aqui
# (y se aplicarian en un .clang-tidy si se agrega) para trazabilidad:
#   - Class / Struct / TypedefAlias : PascalCase (Frame, Message, StateDoc).
#   - Method / Function             : camelCase (encodeFrame, typeToString).
#   - Variable / Parameter          : camelCase (payloadLen, jsonOut).
#   - Field                         : camelCase + sufijo "_" (stream_, rxBuf_).
#   - Constant / GlobalConstant     : prefijo "k" + PascalCase (kMagic, kSampleRate).
#   - EnumConstantValue             : PascalCase.
