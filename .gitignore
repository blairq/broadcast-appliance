# --- Lo que se compila (make, cmake, docker) --------------------------------
build/
build-*/
release/
release-win/
dist/
Testing/
a.out
ba-app-headless/

# --- Dependencias de terceros (make deps) ----------------------------------
# extern/ guarda lo que se baja o se compila desde fuente fijada (Qt, GStreamer,
# ONNX Runtime, libwebrtc, Python, LSP…). Se regenera con `make deps`.
extern/

# --- Python -------------------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# --- Documentación generada ---------------------------------------------------
docs/_build/
docs/doxygen/

# --- Logs y restos en la raíz -------------------------------------------------
# aqtinstall (make deps-qt) y las corridas de entrenamiento escriben su log en el
# cwd; un plugin de servicios RTMP dejaba su catálogo al correr los tests.
/*.log
rtmp-services/

# --- Editores, herramientas y sistema -----------------------------------------
.DS_Store
.claude/
.codemap/
.opencode/
.ghidra_docker/

# --- Entrenamiento del modelo local -------------------------------------------
# Los venv los arma tools/entrenar/venv.sh; unsloth deja su caché.
.venv-entrenar/
.venv-mlx/
unsloth_compiled_cache/
# Lo que genera make corpus-entrenamiento (50-90 MB por versión): se regenera
# desde las semillas, que sí se versionan.
datos/entrenamiento/
# Copias de seguridad de datos: el historial de git ya las guarda.
datos/respaldo/
# Los modelos nunca van al repo (pesan gigas): se publican en Hugging Face y acá
# queda su tarjeta (docs/modelos/).
*.gguf
*.safetensors
*.safetensors.index.json
*.pt
*.pth
*.ckpt
adapter_model.*
checkpoint-*/
imatrix.dat

# --- Material privado de terceros ---------------------------------------------
# El firmware y los manuales del DVD de Bosch, y su desensamblado: solo locales.
docs/bosch/dvd/
docs/bosch/desassembly/
