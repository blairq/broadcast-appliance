# --- Build outputs ----------------------------------------------------------
build/
build-*/
release/
release-win/
dist/

# --- Python -----------------------------------------------------------------
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# --- Docs build artifacts ---------------------------------------------------
docs/_build/
docs/doxygen/

# --- Stray build/test artifacts --------------------------------------------
# El plugin rtmp-services de OBS actualiza su catalogo de servicios en el cwd
# al cargarse, asi que correr los tests deja este directorio en la raiz.
rtmp-services/
a.out
Testing/
ba-app-headless/
# `aqtinstall` (make deps-qt) escribe su log en el cwd al bajar el SDK Qt6.
aqtinstall.log

# --- Dependencias de terceros (descargadas por `make deps`) ----------------
# `extern/` guarda los assets de terceros (libwebrtc, OBS, Spout2, cloudflared,
# VC++ redist, LSP). Se regenera con `make deps`; nunca se commitea.
extern/

# --- Tool / editor / OS state ----------------------------------------------
.codemap/
.opencode/
.DS_Store

# Entrenamiento: el venv lo arma tools/entrenar/venv.sh y unsloth deja su cache
.venv-entrenar/
.venv-mlx/
unsloth_compiled_cache/

# Logs sueltos en la raiz (corridas de entrenamiento, etc.): no van al repo.
/*.log

# TODO lo que genera make corpus-entrenamiento (datos/entrenamiento/): el
# corpus (50-90 MB por version, cada fila repite el prompt entero), su firma y
# el examen (que sale de src/app/tests/datos/preguntas.json). Se regenera igual
# desde las semillas, que si se versionan.
datos/entrenamiento/
# Copias de seguridad de datos: el historial de git ya las guarda.
datos/respaldo/

# MODELOS: nunca al repo (pesan gigas). La fabrica los arma en ~/entrenamientos
# y se publican en Hugging Face; aca solo queda su tarjeta (docs/modelos/).
*.gguf
*.safetensors
*.safetensors.index.json
*.pt
*.pth
*.ckpt
adapter_model.*
checkpoint-*/
imatrix.dat
docs/bosch/dvd/
