// src/obs-module/data/video-grafo.effect — las tarjetas del grafo de video (ba_video_grafo)
//
// Cada tarjeta es una técnica de una pasada. Todo entra y sale con alfa
// PREMULTIPLICADO, como el resto de libobs: se despremultiplica, se procesa y
// se vuelve a premultiplicar.
//
// Ojo (como en mejora-imagen.effect): nada de variables locales de una letra,
// la traducción a GLSL de libobs se rompe.

uniform float4x4 ViewProj;
uniform texture2d image;
uniform float2 texel;

// Color
uniform float brillo;     // -1..1, se suma
uniform float contraste;  // 0..2, alrededor del gris medio
uniform float saturacion; // 0..2
uniform float gamma;      // 0.2..5

// Croma
uniform float2 clave;      // Cb, Cr del color de fondo
uniform float similitud;   // 0..1: cuánto se parece y se va
uniform float suavidad;    // 0..1: el borde
uniform float derrame;     // 0..1: cuánto se le saca el verde al borde

// Recorte (bordes en 0..1) y espejo
uniform float4 borde;      // izquierda, arriba, derecha, abajo
uniform float2 espejo;     // 1 = da vuelta ese eje

// Capa de un compositor
uniform float opacidad;    // 0..1

sampler_state lineal {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 Despremultiplicar(float4 rgba)
{
	float inv = rgba.a > 0.0 ? 1.0 / rgba.a : 0.0;
	return float4(rgba.rgb * inv, rgba.a);
}

float4 PSCopiar(VertInOut vert_in) : TARGET
{
	return image.Sample(lineal, vert_in.uv);
}

// Premultiplicado: la opacidad multiplica todo (color y alfa).
float4 PSCapa(VertInOut vert_in) : TARGET
{
	return image.Sample(lineal, vert_in.uv) * opacidad;
}

float4 PSColor(VertInOut vert_in) : TARGET
{
	float4 rgba = Despremultiplicar(image.Sample(lineal, vert_in.uv));
	float3 col = pow(saturate(rgba.rgb), float3(gamma, gamma, gamma));
	col = (col - 0.5) * contraste + 0.5 + brillo;
	float luma = dot(col, float3(0.2126, 0.7152, 0.0722));
	col = lerp(float3(luma, luma, luma), col, saturacion);
	col = saturate(col);
	return float4(col * rgba.a, rgba.a);
}

float2 CromaDe(float3 rgb)
{
	// BT.709: Cb y Cr centrados en 0,5.
	float cbv = dot(rgb, float3(-0.1146, -0.3854, 0.5)) + 0.5;
	float crv = dot(rgb, float3(0.5, -0.4542, -0.0458)) + 0.5;
	return float2(cbv, crv);
}

float DistanciaCroma(float2 uvp)
{
	float4 rgba = Despremultiplicar(image.Sample(lineal, uvp));
	return distance(CromaDe(rgba.rgb), clave);
}

float4 PSCroma(VertInOut vert_in) : TARGET
{
	float4 rgba = Despremultiplicar(image.Sample(lineal, vert_in.uv));
	// Un promedio chico alrededor: el borde no queda dentado por el ruido.
	float dist = DistanciaCroma(vert_in.uv) * 2.0;
	dist += DistanciaCroma(vert_in.uv + float2(texel.x, 0.0));
	dist += DistanciaCroma(vert_in.uv - float2(texel.x, 0.0));
	dist += DistanciaCroma(vert_in.uv + float2(0.0, texel.y));
	dist += DistanciaCroma(vert_in.uv - float2(0.0, texel.y));
	dist = dist / 6.0;
	float base = dist - similitud * 0.5;
	float mascara = saturate(base / max(suavidad * 0.5, 0.001));
	float quitar = saturate(base / max(derrame * 0.5, 0.001));
	float luma = dot(rgba.rgb, float3(0.2126, 0.7152, 0.0722));
	float3 col = lerp(float3(luma, luma, luma), rgba.rgb, quitar);
	float alfa = rgba.a * mascara;
	return float4(col * alfa, alfa);
}

float4 PSRecorte(VertInOut vert_in) : TARGET
{
	float2 coord = lerp(vert_in.uv, 1.0 - vert_in.uv, espejo);
	float4 rgba = image.Sample(lineal, coord);
	float dentro = step(borde.x, vert_in.uv.x) * step(borde.y, vert_in.uv.y)
		* step(vert_in.uv.x, 1.0 - borde.z) * step(vert_in.uv.y, 1.0 - borde.w);
	return rgba * dentro;
}

float4 PSDespremultiplicar(VertInOut vert_in) : TARGET
{
	return Despremultiplicar(image.Sample(lineal, vert_in.uv));
}

float4 PSPremultiplicar(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(lineal, vert_in.uv);
	return float4(rgba.rgb * rgba.a, rgba.a);
}

technique Despremultiplicar
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDespremultiplicar(vert_in);
	}
}

technique Premultiplicar
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSPremultiplicar(vert_in);
	}
}

technique Copiar
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSCopiar(vert_in);
	}
}

technique Color
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSColor(vert_in);
	}
}

technique Croma
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSCroma(vert_in);
	}
}

technique Recorte
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSRecorte(vert_in);
	}
}

technique Capa
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSCapa(vert_in);
	}
}
